{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://florianliepe.github.io/DEKRA-Pilot/schemas/agent-tool-registry.schema.json",
  "title": "DEKRA callable agent-tool registry",
  "type": "object",
  "required": ["version", "policy", "tools"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policy": {
      "type": "object",
      "required": ["defaultAccess", "unrestrictedNetwork", "unrestrictedFilesystem", "credentialAccess", "workflowAdministration", "publicationAccess", "licensedContentAccess"],
      "properties": {
        "defaultAccess": { "const": "deny" },
        "unrestrictedNetwork": { "const": false },
        "unrestrictedFilesystem": { "const": false },
        "credentialAccess": { "const": false },
        "workflowAdministration": { "const": false },
        "publicationAccess": { "const": false },
        "licensedContentAccess": { "const": false }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "inputSchema", "outputSchema", "requiredPermission", "allowedDataClassifications", "timeoutMs", "retryPolicy", "rateLimit", "errorContract", "auditRequirements", "version", "lifecycleStatus", "owner", "allowedAgentActions"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 3 },
          "purpose": { "type": "string", "minLength": 12 },
          "inputSchema": { "$ref": "#/$defs/toolSchema" },
          "outputSchema": { "$ref": "#/$defs/toolSchema" },
          "requiredPermission": { "type": "string", "pattern": "^skill\\." },
          "allowedDataClassifications": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["public", "internal", "confidential"] } },
          "timeoutMs": { "type": "integer", "minimum": 1 },
          "retryPolicy": { "$ref": "#/$defs/retryPolicy" },
          "rateLimit": { "$ref": "#/$defs/rateLimit" },
          "errorContract": { "$ref": "#/$defs/errorContract" },
          "auditRequirements": { "type": "array", "uniqueItems": true, "allOf": [{ "contains": { "const": "correlationId" } }, { "contains": { "const": "actingUser" } }, { "contains": { "const": "inputRef" } }, { "contains": { "const": "durationMs" } }, { "contains": { "const": "result" } }] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "lifecycleStatus": { "enum": ["draft", "active", "deprecated", "disabled"] },
          "owner": { "type": "string" },
          "allowedAgentActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["execute", "audit"] } }
        }
      }
    }
  },
  "$defs": {
    "toolSchema": { "type": "object", "required": ["type", "required", "properties"], "properties": { "type": { "const": "object" }, "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "properties": { "type": "object", "minProperties": 1 } } },
    "retryPolicy": { "type": "object", "additionalProperties": false, "required": ["maxAttempts", "backoffMs", "retryableErrors"], "properties": { "maxAttempts": { "type": "integer", "minimum": 1 }, "backoffMs": { "type": "integer", "minimum": 0 }, "retryableErrors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } },
    "rateLimit": { "type": "object", "additionalProperties": false, "required": ["requests", "windowSeconds"], "properties": { "requests": { "type": "integer", "minimum": 1 }, "windowSeconds": { "type": "integer", "minimum": 1 } } },
    "errorContract": { "type": "object", "additionalProperties": false, "required": ["codes", "redactInputs"], "properties": { "codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "redactInputs": { "const": true } } }
  }
}
