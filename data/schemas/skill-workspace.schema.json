{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://florianliepe.github.io/DEKRA-Pilot/schemas/skill-workspace.schema.json",
  "title": "DEKRA governed skill workspace",
  "type": "object",
  "required": ["schemaVersion", "revision", "updatedAt", "domains", "groups", "relationships", "skills", "profiles", "interviews", "jobClarifications", "elicitationSessions", "reviewQueue", "kflaFactors", "kflaClusters", "kfla", "jobDescriptions", "mappings", "mappingOmissions", "mappingFeedback", "strategicVectors", "agentRuns", "tools", "agentTools", "validationRules", "proficiencyDefinitions", "sources", "evidenceRecords", "localizedLabels", "auditLog", "objectVersions", "releaseHistory", "framework", "publication"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/taxonomyNode" } },
    "groups": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/taxonomyNode" }, { "type": "object", "required": ["domainId"], "properties": { "domainId": { "type": "string" } } }] } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/taxonomyRelationship" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/governedObject" } },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/roleProfile" } },
    "interviews": { "type": "array" },
    "jobClarifications": { "type": "array", "items": { "$ref": "#/$defs/jobClarification" } },
    "elicitationSessions": { "type": "array", "items": { "$ref": "#/$defs/elicitationSession" } },
    "reviewQueue": { "type": "array" },
    "kflaFactors": { "type": "array", "maxItems": 4 },
    "kflaClusters": { "type": "array", "maxItems": 12 },
    "kfla": { "type": "array", "maxItems": 38 },
    "jobDescriptions": { "type": "array", "items": { "$ref": "#/$defs/jobDescription" } },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/jobSkillMapping" } },
    "mappingOmissions": { "type": "array", "items": { "$ref": "#/$defs/mappingOmission" } },
    "mappingFeedback": { "type": "array", "items": { "$ref": "#/$defs/mappingFeedback" } },
    "strategicVectors": { "type": "array" },
    "agentRuns": { "type": "array" },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/controlledTool" } },
    "agentTools": { "type": "array" },
    "validationRules": { "type": "array" },
    "proficiencyDefinitions": { "type": "array", "maxItems": 4 },
    "sources": { "type": "array" },
    "evidenceRecords": { "type": "array" },
    "localizedLabels": { "type": "array", "items": { "$ref": "#/$defs/localizedLabel" } },
    "auditLog": { "type": "array" },
    "objectVersions": { "type": "array" },
    "releaseHistory": { "type": "array" },
    "framework": { "type": "object", "required": ["version", "rulesVersion", "promptVersion", "mappingScoreVersion", "mappingWeights"] },
    "publication": { "type": "object", "required": ["revision", "state", "githubPath"] }
  },
  "allOf": [{
    "if": { "properties": { "revision": { "minimum": 1 } }, "required": ["revision"] },
    "then": { "properties": {
      "kflaFactors": { "minItems": 4, "maxItems": 4 },
      "kflaClusters": { "minItems": 12, "maxItems": 12 },
      "kfla": { "minItems": 38, "maxItems": 38 },
      "agentTools": { "minItems": 11 },
      "proficiencyDefinitions": { "minItems": 4, "maxItems": 4 }
    } }
  }],
  "$defs": {
    "governedObject": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["draft", "in_review", "approved", "archived", "deprecated", "retired"] } } },
    "taxonomyNode": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" } } }] },
    "taxonomyRelationship": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["sourceId", "targetId", "type", "rationale"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "type": { "enum": ["broader", "narrower", "related", "prerequisite", "replacement", "synonym"] }, "rationale": { "type": "string", "minLength": 1 } } }] },
    "profileSkill": { "type": "object", "additionalProperties": false, "required": ["skillId", "targetLevel", "weight", "critical"], "properties": { "skillId": { "type": "string", "minLength": 1 }, "targetLevel": { "type": "integer", "minimum": 1, "maximum": 4 }, "weight": { "type": "number", "minimum": 0, "maximum": 100 }, "critical": { "type": "boolean" } } },
    "roleProfile": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["title", "jobFamily", "purpose", "skills"], "properties": { "title": { "type": "string", "minLength": 1 }, "jobFamily": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "jobDescriptionId": { "type": "string", "minLength": 1 }, "strategicVectorIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "skills": { "type": "array", "items": { "$ref": "#/$defs/profileSkill" } } } }] },
    "controlledTool": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["name", "category", "description", "aliases", "skillIds", "allowedAgentActions"], "properties": { "name": { "type": "string", "minLength": 1 }, "category": { "enum": ["method", "technology", "regulation", "data", "workflow"] }, "description": { "type": "string", "minLength": 1 }, "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "skillIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "allowedAgentActions": { "type": "array", "items": { "enum": ["read", "suggest_mapping", "validate"] }, "uniqueItems": true } } }] },
    "localizedLabel": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["entityType", "entityId", "language", "label", "sourceClassification", "licenceStatus"], "properties": { "entityType": { "enum": ["domain", "group", "skill", "kfla_factor", "kfla_cluster", "kfla_competency", "controlled_tool"] }, "entityId": { "type": "string", "minLength": 1 }, "language": { "type": "string", "minLength": 2 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "sourceClassification": { "enum": ["public", "organization_authored"] }, "licenceStatus": { "enum": ["public_metadata", "internal_explanation"] } } }] },
    "mappingFeedback": { "type": "object", "additionalProperties": false, "required": ["id", "mappingId", "decision", "reviewer", "reviewerRole", "reason", "recordedAt", "confidenceBefore", "evidenceCompleteness", "frameworkVersion", "rulesVersion", "scoreVersion", "promptVersion"], "properties": { "id": { "type": "string", "minLength": 1 }, "mappingId": { "type": "string", "minLength": 1 }, "decision": { "enum": ["confirmed", "adjusted", "rejected", "needs_evidence"] }, "reviewer": { "type": "string", "minLength": 1 }, "reviewerRole": { "enum": ["taxonomy_steward", "job_architect"] }, "reason": { "type": "string", "minLength": 1 }, "recordedAt": { "type": "string", "format": "date-time" }, "confidenceBefore": { "type": "number", "minimum": 0, "maximum": 100 }, "confidenceAfter": { "type": "number", "minimum": 0, "maximum": 100 }, "evidenceCompleteness": { "type": "number", "minimum": 0, "maximum": 100 }, "frameworkVersion": { "type": "string" }, "rulesVersion": { "type": "string" }, "scoreVersion": { "type": "string" }, "promptVersion": { "type": "string" } } },
    "jobEvidenceSegment": { "type": "object", "additionalProperties": false, "required": ["id", "sourceId", "sourceName", "section", "location", "quotation", "normalizedType", "normalizedValue", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "sourceName": { "type": "string", "minLength": 1 }, "section": { "type": "string" }, "location": { "type": "string", "minLength": 1 }, "quotation": { "type": "string", "minLength": 1 }, "normalizedType": { "enum": ["purpose", "responsibility", "outcome", "activity", "tool", "qualification", "context", "constraint"] }, "normalizedValue": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 100 } } },
    "jobDescription": { "type": "object", "required": ["id", "title", "jobFamily", "country", "language", "purpose", "sourceText", "responsibilities", "outcomes", "activities", "tools", "qualifications", "context", "constraints", "evidenceSegments", "sourceFiles", "intakeFindings", "status", "version", "updatedAt"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "jobFamily": { "type": "string", "minLength": 1 }, "evidenceSegments": { "type": "array", "items": { "$ref": "#/$defs/jobEvidenceSegment" } }, "sourceFiles": { "type": "array" }, "intakeFindings": { "type": "array" }, "status": { "enum": ["draft", "analysed", "mapped", "approved", "archived"] }, "version": { "type": "integer", "minimum": 1 }, "updatedAt": { "type": "string", "format": "date-time" } } },
    "mappingScore": { "type": "object", "additionalProperties": false, "required": ["semanticRelevance", "directEvidenceStrength", "responsibilityCoverage", "outcomeRelevance", "taxonomyCompatibility", "granularityCompatibility", "kflaCompatibility", "controlledToolRelevance", "proficiencyCompatibility", "approvedMappingSimilarity", "duplicatePenalty", "contradictionPenalty", "missingEvidencePenalty"], "properties": { "semanticRelevance": { "type": "number", "minimum": 0, "maximum": 100 }, "directEvidenceStrength": { "type": "number", "minimum": 0, "maximum": 100 }, "responsibilityCoverage": { "type": "number", "minimum": 0, "maximum": 100 }, "outcomeRelevance": { "type": "number", "minimum": 0, "maximum": 100 }, "taxonomyCompatibility": { "type": "number", "minimum": 0, "maximum": 100 }, "granularityCompatibility": { "type": "number", "minimum": 0, "maximum": 100 }, "kflaCompatibility": { "type": "number", "minimum": 0, "maximum": 100 }, "controlledToolRelevance": { "type": "number", "minimum": 0, "maximum": 100 }, "proficiencyCompatibility": { "type": "number", "minimum": 0, "maximum": 100 }, "approvedMappingSimilarity": { "type": "number", "minimum": 0, "maximum": 100 }, "duplicatePenalty": { "type": "number", "minimum": 0, "maximum": 100 }, "contradictionPenalty": { "type": "number", "minimum": 0, "maximum": 100 }, "missingEvidencePenalty": { "type": "number", "minimum": 0, "maximum": 100 } } },
    "jobSkillMapping": { "type": "object", "required": ["id", "jobDescriptionId", "skillId", "targetLevel", "weight", "critical", "relevance", "rationale", "evidence", "strategicVectorIds", "source", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "jobDescriptionId": { "type": "string", "minLength": 1 }, "skillId": { "type": "string", "minLength": 1 }, "targetLevel": { "type": "integer", "minimum": 1, "maximum": 4 }, "weight": { "type": "number", "minimum": 0, "maximum": 100 }, "relevance": { "type": "number", "minimum": 0, "maximum": 100 }, "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "scoreBreakdown": { "$ref": "#/$defs/mappingScore" }, "scoreVersion": { "type": "string" }, "frameworkVersion": { "type": "string" }, "rulesVersion": { "type": "string" }, "promptVersion": { "type": "string" }, "evaluationDatasetVersion": { "type": "string" }, "source": { "enum": ["agent", "manual"] }, "status": { "enum": ["proposed", "approved", "rejected", "deferred"] } } },
    "mappingOmission": { "type": "object", "additionalProperties": false, "required": ["id", "jobDescriptionId", "skillId", "reason", "evidenceRefs", "status", "agentRunId"], "properties": { "id": { "type": "string", "minLength": 1 }, "jobDescriptionId": { "type": "string", "minLength": 1 }, "skillId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "score": { "type": "number", "minimum": 0, "maximum": 100 }, "status": { "enum": ["explained", "challenged", "superseded"] }, "agentRunId": { "type": "string", "minLength": 1 } } },
    "jobClarification": { "type": "object", "additionalProperties": false, "required": ["id", "jobDescriptionId", "status", "currentQuestion", "questions", "startedAt", "updatedAt", "idempotencyKey"], "properties": { "id": { "type": "string", "minLength": 1 }, "jobDescriptionId": { "type": "string", "minLength": 1 }, "status": { "enum": ["draft", "in_progress", "complete"] }, "currentQuestion": { "type": "integer", "minimum": 0 }, "questions": { "type": "array" }, "startedAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "idempotencyKey": { "type": "string", "minLength": 1 } } },
    "elicitationEvidence": { "type": "object", "additionalProperties": false, "required": ["id", "location", "quote", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string" }, "location": { "type": "string" }, "quote": { "type": "string" }, "status": { "enum": ["draft", "verified"] } } },
    "elicitationSession": { "type": "object", "additionalProperties": false, "required": ["id", "title", "status", "currentStep", "updatedAt", "fields"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "status": { "enum": ["draft", "in_progress", "submitted", "completed"] }, "currentStep": { "type": "integer", "minimum": 0 }, "updatedAt": { "type": "string", "format": "date-time" }, "fields": { "type": "object", "required": ["capability", "activities", "outcomes", "knowledge", "tools", "context", "constraints", "granularity", "synonyms", "kflaCompetencyIds", "proficiencyIndicators"], "properties": { "capability": { "type": "string" }, "activities": { "type": "string" }, "outcomes": { "type": "string" }, "knowledge": { "type": "string" }, "tools": { "type": "string" }, "context": { "type": "string" }, "constraints": { "type": "string" }, "granularity": { "enum": ["atomic", "composite", "umbrella"] }, "synonyms": { "type": "string" }, "kflaCompetencyIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "proficiencyIndicators": { "type": "string" } } }, "fieldEvidence": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/elicitationEvidence" } } } } }
  },
  "additionalProperties": true
}
