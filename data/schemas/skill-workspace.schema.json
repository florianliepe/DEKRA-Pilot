{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://florianliepe.github.io/DEKRA-Pilot/schemas/skill-workspace.schema.json",
  "title": "DEKRA governed skill workspace",
  "type": "object",
  "required": ["schemaVersion", "revision", "updatedAt", "domains", "groups", "relationships", "skills", "profiles", "interviews", "elicitationSessions", "reviewQueue", "kflaFactors", "kflaClusters", "kfla", "jobDescriptions", "mappings", "strategicVectors", "agentRuns", "tools", "agentTools", "validationRules", "proficiencyDefinitions", "sources", "evidenceRecords", "localizedLabels", "auditLog", "objectVersions", "releaseHistory", "framework", "publication"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/taxonomyNode" } },
    "groups": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/taxonomyNode" }, { "type": "object", "required": ["domainId"], "properties": { "domainId": { "type": "string" } } }] } },
    "relationships": { "type": "array" },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/governedObject" } },
    "profiles": { "type": "array" },
    "interviews": { "type": "array" },
    "elicitationSessions": { "type": "array" },
    "reviewQueue": { "type": "array" },
    "kflaFactors": { "type": "array", "maxItems": 4 },
    "kflaClusters": { "type": "array", "maxItems": 12 },
    "kfla": { "type": "array", "maxItems": 38 },
    "jobDescriptions": { "type": "array" },
    "mappings": { "type": "array" },
    "strategicVectors": { "type": "array" },
    "agentRuns": { "type": "array" },
    "tools": { "type": "array" },
    "agentTools": { "type": "array" },
    "validationRules": { "type": "array" },
    "proficiencyDefinitions": { "type": "array", "maxItems": 4 },
    "sources": { "type": "array" },
    "evidenceRecords": { "type": "array" },
    "localizedLabels": { "type": "array", "items": { "$ref": "#/$defs/localizedLabel" } },
    "auditLog": { "type": "array" },
    "objectVersions": { "type": "array" },
    "releaseHistory": { "type": "array" },
    "framework": { "type": "object", "required": ["version", "rulesVersion", "promptVersion", "mappingScoreVersion", "mappingWeights"] },
    "publication": { "type": "object", "required": ["revision", "state", "githubPath"] }
  },
  "allOf": [{
    "if": { "properties": { "revision": { "minimum": 1 } }, "required": ["revision"] },
    "then": { "properties": {
      "kflaFactors": { "minItems": 4, "maxItems": 4 },
      "kflaClusters": { "minItems": 12, "maxItems": 12 },
      "kfla": { "minItems": 38, "maxItems": 38 },
      "agentTools": { "minItems": 11 },
      "proficiencyDefinitions": { "minItems": 4, "maxItems": 4 }
    } }
  }],
  "$defs": {
    "governedObject": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["draft", "in_review", "approved", "archived", "deprecated", "retired"] } } },
    "taxonomyNode": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" } } }] },
    "localizedLabel": { "allOf": [{ "$ref": "#/$defs/governedObject" }, { "type": "object", "required": ["entityType", "entityId", "language", "label", "sourceClassification", "licenceStatus"], "properties": { "entityType": { "enum": ["domain", "group", "skill", "kfla_factor", "kfla_cluster", "kfla_competency", "controlled_tool"] }, "entityId": { "type": "string", "minLength": 1 }, "language": { "type": "string", "minLength": 2 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "sourceClassification": { "enum": ["public", "organization_authored"] }, "licenceStatus": { "enum": ["public_metadata", "internal_explanation"] } } }] }
  },
  "additionalProperties": true
}
