    { "id": "wef-foj-2025", "name": "WEF Future of Jobs Report 2025", "url": "https://www.weforum.org/publications/the-future-of-jobs-report-2025/digest/", "type": "research" },
    { "id": "iea-ev-2026", "name": "IEA Global EV Outlook 2026", "url": "https://www.iea.org/reports/global-ev-outlook-2026", "type": "research" },
    { "id": "iea-h2-2025", "name": "IEA Global Hydrogen Review 2025", "url": "https://www.iea.org/reports/global-hydrogen-review-2025", "type": "research" },
