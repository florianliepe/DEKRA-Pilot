    { "id": "dekra-digital", "name": "DEKRA Digital Services", "url": "https://www.dekra.com/en/digital-services/", "type": "internal_public" },
    { "id": "dekra-remote", "name": "DEKRA Remote Inspection", "url": "https://www.dekra.com/en/precise-remote-inspections-in-real-time/", "type": "internal_public" }
