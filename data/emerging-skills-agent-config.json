{
  "schemaVersion": "1.1.0",
  "frameworkVersion": "DEKRA-emerging-skills-1.1.0",
  "updatedAt": "2026-10-23",
  "runtime": {
    "contract": "async-trend-radar-1.0.0",
    "startWebhook": "skill-designer-trend-radar-async-v1",
    "controlWebhook": "skill-designer-trend-radar-control-v1",
    "persistence": "n8n Data Table",
    "polling": { "initialMilliseconds": 2000, "maximumMilliseconds": 15000, "backoffMultiplier": 1.55 },
    "terminalStates": ["completed", "failed", "interrupted", "stale"],
    "humanReviewRequired": true,
    "publicationAllowed": false
  },
  "cadence": {
    "scheduled": "quarterly",
    "eventDriven": true,
    "events": ["material regulation published", "authoritative standard updated", "DEKRA strategy or service portfolio changed", "repeated skill gap detected across job descriptions"]
  },
  "governance": {
    "agentAuthority": ["read allowlisted sources", "extract signals", "compare catalogues and role evidence", "score", "draft candidates", "prepare review packages"],
    "prohibitedAgentAuthority": ["approve", "publish", "edit approved skills", "edit source job descriptions"],
    "validation": "functional SME",
    "taxonomyReview": "HR taxonomy steward",
    "approval": "appointed governance board"
  },
  "priorityWeights": {
    "strategicFit": 0.28,
    "urgency": 0.22,
    "valueImpact": 0.20,
    "roleBreadth": 0.15,
    "gapMagnitude": 0.15
  },
  "catalogueRules": {
    "categories": ["technical", "functional", "behavioral"],
    "profileMaximum": 10,
    "behavioralShareTarget": 0.5,
    "allowEvidenceBasedExceptions": true,
    "jobDescriptionIsImmutable": true,
    "newSkillRequires": ["observable global definition", "distinct catalogue boundary", "evidence reference", "level expectation", "named functional home or provisional group", "SME validation", "governance approval"]
  },
  "proficiencyModel": {
    "levels": [
      { "level": 1, "label": "Guided application", "summary": "Applies the skill with direction, examples and review." },
      { "level": 2, "label": "Independent application", "summary": "Applies the skill independently in recurring work." },
      { "level": 3, "label": "Broad application", "summary": "Applies the skill across complex contexts and guides others." },
      { "level": 4, "label": "Strategic contribution", "summary": "Shapes standards, direction and functional capability through the skill." }
    ],
    "differentiationLevers": ["knowledge & collaboration", "problem solving", "accountability", "impact"],
    "requireSkillSpecificObservableDescriptions": true
  },
  "sources": [
    { "id": "eu-ai", "name": "European Commission — Artificial Intelligence", "url": "https://commission.europa.eu/topics/artificial-intelligence_en", "type": "regulator" },
