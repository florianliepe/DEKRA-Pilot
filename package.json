  "dependencies": {
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "next": "^16.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "8.0.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
