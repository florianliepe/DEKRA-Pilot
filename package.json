    "verify:agent-policy": "node scripts/verify-agent-policy.mjs",
    "sync:n8n-v3": "node scripts/sync-n8n-v3.mjs",
    "sync:n8n-zm01": "node scripts/sync-zm01-n8n.mjs",
    "sync:n8n-zm02": "node scripts/sync-zm02-n8n.mjs",
    "sync:n8n-zm03": "node scripts/sync-zm03-n8n.mjs",
    "sync:n8n-zm04": "node scripts/sync-zm04-agent-tools.mjs",
    "sync:n8n-zm05": "node scripts/sync-zm05-mapping-quality.mjs",
    "sync:n8n-zm07": "node scripts/sync-zm07-pilot-readiness.mjs",
    "sync:n8n-zm09": "node scripts/sync-zm09-uat-quality.mjs",
    "sync:n8n-zm10": "node scripts/sync-n8n-zm10-runtime.mjs",
    "sync:n8n-zm11": "node scripts/sync-n8n-zm11-clarification.mjs",
    "sync:n8n-zm12": "node scripts/sync-n8n-zm12-explainability.mjs",
    "sync:n8n-zm13": "node scripts/sync-n8n-zm13-mece-mapping.mjs",
