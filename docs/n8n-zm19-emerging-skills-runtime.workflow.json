      ],
      "parameters": {
        "jsCode": "const row=$json;const prepared=$('Prepare Trend Interruption Check').first().json;const run=JSON.parse(row.runJson||'{}');const request=JSON.parse(row.requestJson||'{}');if(row.interruptRequested===true){Object.assign(run,{status:'interrupted',stage:'Interrupted safely',progress:100,completedAt:new Date().toISOString(),updatedAt:new Date().toISOString()});return[{json:{...row,status:run.status,runJson:JSON.stringify(run),resultJson:'',workspaceJson:'',interruptRequested:true}}];}try{const fence=String.fromCharCode(96).repeat(3);let cleaned=prepared.agentOutput.trim();if(cleaned.startsWith(fence))cleaned=cleaned.slice(3).replace(/^json/i,'').trim();if(cleaned.endsWith(fence))cleaned=cleaned.slice(0,-3).trim();const analysis=cleaned?JSON.parse(cleaned):request.baseline;if(!Array.isArray(analysis?.signals)||!Array.isArray(analysis?.candidates))throw new Error('Agent response omitted signals or candidates.');const generatedAt=new Date().toISOString();const fallback=!cleaned;const snapshot={id:'TRS-'+run.id,version:Number(generatedAt.replace(/[-:TZ.]/g,'').slice(0,12)),generatedAt,sourceCutoffAt:run.sourceCutoffAt,configVersion:run.configVersion,promptVersion:'DEKRA-trend-agent-1.0.0',signals:analysis.signals,candidates:analysis.candidates,sourceCount:new Set(analysis.signals.map(item=>item.sourceUrl).filter(Boolean)).size,analysisMode:fallback?'baseline_preserved':'agent_refreshed'};Object.assign(run,{status:'completed',stage:fallback?'Source scan completed; baseline preserved for review':'Candidate snapshot ready for human review',progress:100,snapshotVersion:snapshot.version,resultReference:'n8n-data-table://DEKRA-Skill-Mapping-Runs/'+run.id,completedAt:generatedAt,updatedAt:generatedAt});if(fallback)run.warning='The governed model returned no usable content. No new claims were introduced; the previous baseline was preserved.';return[{json:{...row,status:run.status,runJson:JSON.stringify(run),resultJson:JSON.stringify({ok:true,snapshot,warning:run.warning}),workspaceJson:JSON.stringify(snapshot),interruptRequested:false}}];}catch(error){Object.assign(run,{status:'failed',stage:'Analysis validation failed',progress:100,error:{code:'TREND_RESULT_INVALID',message:String(error.message||error),retryable:true},completedAt:new Date().toISOString(),updatedAt:new Date().toISOString()});return[{json:{...row,status:run.status,runJson:JSON.stringify(run),resultJson:JSON.stringify({ok:false,error:run.error.message}),workspaceJson:'',interruptRequested:false}}];}"
