    {
      "id": "zm19-apply",
      "name": "Apply Trend Control Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        360
      ],
      "parameters": {
        "jsCode": "const command=$('Validate Trend Control Command').first().json;if(!$json.runId)return[{json:{ok:false,statusCode:404,error:'Trend-analysis run was not found.',write:false}}];const run=JSON.parse($json.runJson||'{}');const terminal=['completed','failed','interrupted','stale'];const active=['queued','screening','comparing','preparing_review','interrupt_requested'];const age=Date.now()-new Date(run.updatedAt||run.startedAt||0).getTime();if(active.includes(run.status)&&age>10*60*1000){Object.assign(run,{status:'stale',stage:'Worker stopped before a terminal receipt',progress:100,error:{code:'TREND_WORKER_STALE',message:'The n8n worker stopped updating this run. Retry from the last trusted snapshot.',retryable:true},completedAt:new Date().toISOString(),updatedAt:new Date().toISOString()});return[{json:{...$json,status:run.status,runJson:JSON.stringify(run),write:true,response:{ok:true,trendRun:run,message:'The abandoned run was marked stale and can be retried safely.'}}}];}if(command.mode==='skill.trend_scan.interrupt'&&!terminal.includes(run.status)){Object.assign(run,{status:'interrupt_requested',stage:'Stopping at a controlled checkpoint',updatedAt:new Date().toISOString()});return[{json:{...$json,status:run.status,runJson:JSON.stringify(run),interruptRequested:true,write:true,response:{ok:true,trendRun:run,message:'Interruption requested. The run will stop at its next controlled checkpoint.'}}}];}const response={ok:true,trendRun:run};if(command.mode==='skill.trend_scan.result'){if(run.status!=='completed')return[{json:{ok:false,statusCode:409,error:'Trend-analysis result is not ready.',trendRun:run,write:false}}];response.snapshot=$json.workspaceJson?JSON.parse($json.workspaceJson):undefined;}return[{json:{...response,write:false}}];"
      }
    },
